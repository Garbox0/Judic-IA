      "id": "fetch-keywords",
      "name": "Fetch Keywords de Usuarios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 500]
    },
    {
      "parameters": {
        "jsCode": "// Match BO items against user keywords\nconst boData = $('Combinar Datos BO').item.json.boData;\nconst keywords = $('Fetch Keywords de Usuarios').all();\n\nconst allItems = [\n  ...(boData.primera?.items || []),\n  ...(boData.segunda?.items || []),\n];\n\n// Group keywords by user phone\nconst userKeywords = {};\nfor (const kw of keywords) {\n  const phone = kw.json?.profiles?.whatsapp_phone;\n  if (!phone) continue;\n  if (!userKeywords[phone]) userKeywords[phone] = [];\n  userKeywords[phone].push(kw.json.keyword.toLowerCase());\n}\n\n// For each user, find matching BO items\nconst notifications = [];\nfor (const [phone, kws] of Object.entries(userKeywords)) {\n  const matches = allItems.filter(item => {\n    const text = (item.titulo + ' ' + (item.subtitulo || '')).toLowerCase();\n    return kws.some(kw => text.includes(kw));\n  });\n  \n  if (matches.length === 0) continue;\n  \n  let msg = '📰 *Boletín Oficial — ' + new Date().toLocaleDateString('es-AR') + '*\\n\\n';\n  msg += 'Publicaciones que coinciden con tus palabras clave:\\n\\n';\n  for (const m of matches.slice(0, 5)) {\n    msg += `• *${m.rubro || ''}* ${m.titulo}\\n`;\n    if (m.subtitulo) msg += `  ${m.subtitulo}\\n`;\n  }\n  if (matches.length > 5) msg += `\\n_...y ${matches.length - 5} más_`;\n  msg += '\\n\\n_Ver más en judic-ia.com/dashboard/boletin_';\n  \n  notifications.push({ json: { phone, message: msg } });\n}\n\nif (notifications.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nreturn notifications;"
      },
